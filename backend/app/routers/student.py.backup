    )

    return {
        "lecture_id": lecture_id,
        "ai_summary": summary_info["summary"],
        "ai_revision_notes": summary_info["revision_notes"],
        "final_video_quiz": FINAL_VIDEO_QUIZZES.get(lecture_id),
        "session_analytics": {
            "total_pauses": state["paused"],
            "total_rewinds": state["rewound"],
            "total_seeks": state["seeked"],
            "forward_seeks": state["forward_seeks"],
            "playback_speed_changes": state["speed_changes"],
            "watch_percentage": int(state["completion_percentage"]),
            "watch_time": state["watch_time"],
            "confusion_score": state["confusion_score"],
            "confusion_status": state["confusion_status"],
            "quiz_score": (
                f"{state['quiz_score']}%" if state["quiz_attempts"] > 0 else "N/A"
            ),
            "quiz_threshold": QUIZ_PASS_THRESHOLD,
            "manual_confusion": state["manual_confusion"],
            "repeated_timestamps": state["repeated_timestamps"],
            "confusion_timestamps": state["confusion_timestamps"],
        },
    }


