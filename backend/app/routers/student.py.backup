        state = {
            "paused": 0,
            "rewound": 0,
            "seeked": 0,
            "forward_seeks": 0,
            "speed_changes": 0,
            "watch_time": 0.0,
            "completion_percentage": 0.0,
            "quiz_attempts": 0,
            "quiz_passed": False,
            "quiz_score": 0,
            "confusion_score": 0,
            "confusion_status": "Low Confusion",
            "manual_confusion": 0,
            "repeated_timestamps": [],
            "confusion_timestamps": [],
        }

    summary_info = MOCK_SUMMARIES.get(
        lecture_id,
        {
            "summary": "Summary unavailable.",
