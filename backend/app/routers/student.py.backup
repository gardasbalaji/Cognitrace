# ACTIVE SESSION
# ============================================================


@router.get("/active-session")
def get_active_session(current_student: User = Depends(get_current_student)):
    student_data = get_student_data(current_student)
    ACTIVE_SESSION_STATE = student_data["active_session"]
    return ACTIVE_SESSION_STATE


# ============================================================
# SELECT SESSION
# ============================================================


@router.post("/session/select")
def select_session(req: dict, current_student: User = Depends(get_current_student)):
    student_data = get_student_data(current_student)
    SESSIONS_STORE = student_data["sessions"]
    WATCH_HISTORY = student_data["watch_history"]
    ACTIVE_SESSION_STATE = student_data["active_session"]
    MOCK_LECTURES = student_data["lectures"]
    lec_id = req.get("lecture_id")
    if not lec_id:
        raise HTTPException(status_code=400, detail="Missing lecture_id")

    lecture = next((l for l in MOCK_LECTURES if l["id"] == lec_id), None)
    if not lecture:
        raise HTTPException(status_code=404, detail="Lecture not found")

    current_id = ACTIVE_SESSION_STATE.get("lecture_id")
    if current_id:
        SESSIONS_STORE[current_id] = dict(ACTIVE_SESSION_STATE)

    if lec_id in SESSIONS_STORE:
        ACTIVE_SESSION_STATE.clear()
        ACTIVE_SESSION_STATE.update(SESSIONS_STORE[lec_id])
    else:
        ACTIVE_SESSION_STATE.clear()
        ACTIVE_SESSION_STATE.update(create_empty_session(lec_id, lecture, current_student.full_name))
        SESSIONS_STORE[lec_id] = dict(ACTIVE_SESSION_STATE)

    WATCH_HISTORY[lec_id] = {
        "id": lec_id,
        "title": lecture["title"],
        "progress": int(ACTIVE_SESSION_STATE["completion_percentage"]),
        "last_watched": "Just now",
    }

    return ACTIVE_SESSION_STATE


# ============================================================
# RESET
# ============================================================


@router.post("/reset")
def reset_session(current_student: User = Depends(get_current_student)):
    student_data = get_student_data(current_student)
    SESSIONS_STORE = student_data["sessions"]
    WATCH_HISTORY = student_data["watch_history"]
    ACTIVE_SESSION_STATE = student_data["active_session"]
    SESSIONS_STORE.clear()
    WATCH_HISTORY.clear()
    ACTIVE_SESSION_STATE.clear()
    return {"status": "reset_completed"}


# ============================================================
# SMART SEARCH
# ============================================================


@router.post("/search")
def smart_search(
    query: SearchQuery, current_student: User = Depends(get_current_student)
):
    student_data = get_student_data(current_student)
    TRANSCRIPTS_STORE = student_data["transcripts"]
    MOCK_LECTURES = student_data["lectures"]
    q = query.query.lower()
    hits = []

    for lec_id, entries in TRANSCRIPTS_STORE.items():
        lec_title = "Unknown Lecture"
        for lec in MOCK_LECTURES:
            if lec["id"] == lec_id:
                lec_title = lec["title"]
                break

        for item in entries:
            if q in item["text"].lower():
                hits.append(
                    {
                        "lecture_id": lec_id,
                        "lecture_title": lec_title,
                        "timestamp": item["timestamp"],
                        "seconds": item["seconds"],
                        "snippet": item["text"],
                        "relevance": 95,
                    }
                )

    if not hits:
        hits.append(
            {
                "lecture_id": "lec_2",
                "lecture_title": "Selected Lecture",
                "timestamp": "00:00",
                "seconds": 0,
                "snippet": f"No direct matches for '{query.query}'.",
                "relevance": 40,
            }
        )

    return {"query": query.query, "results": hits}


# ============================================================
# YOUTUBE LECTURE IMPORT
# ============================================================


@router.post("/youtube-lecture")
def create_youtube_lecture(
    req: YouTubeLectureRequest, current_student: User = Depends(get_current_student)
):
    student_data = get_student_data(current_student)
    MOCK_LECTURES = student_data["lectures"]
    TRANSCRIPTS_STORE = student_data["transcripts"]
    MOCK_SUMMARIES = student_data["summaries"]
    video_id = extract_youtube_video_id(req.url)
    if not video_id:
        raise HTTPException(status_code=400, detail="Invalid YouTube URL format.")

    meta = get_youtube_metadata(video_id)

    try:
        api = YouTubeTranscriptApi()
        transcript_list = api.list(video_id)
        selected_language = "en"
        try:
            transcript = transcript_list.find_transcript(["en"])
        except Exception:
            transcript = next(iter(transcript_list))
            selected_language = transcript.language_code

        fetched_data = transcript.fetch()
    except Exception:
        raise HTTPException(
            status_code=400, detail="Transcript unavailable for this video."
        )

    formatted_entries = []
    max_seconds = 0

    for item in fetched_data:
        start_seconds = float(item.start)
        duration = float(item.duration)
        end_seconds = start_seconds + duration
        max_seconds = max(max_seconds, end_seconds)

        formatted_entries.append(
            {
                "timestamp": format_seconds_to_timestamp(start_seconds),
                "seconds": int(start_seconds),
                "end_time": format_seconds_to_timestamp(end_seconds),
                "text": item.text,
                "speaker": "Speaker",
            }
        )

    new_lec_id = f"lec_{uuid.uuid4().hex}"
    duration_str = format_seconds_to_timestamp(max_seconds)

    new_lecture = {
        "id": new_lec_id,
        "title": meta["title"],
        "duration": duration_str,
        "video_url": req.url,
        "video_type": "youtube",
        "youtube_id": video_id,
        "category": "YouTube Imports",
        "description": f"Imported from YouTube. Creator: {meta['author']}",
        "prerequisites": [],
        "concepts": ["Imported Concept"],
        "thumbnail": meta["thumbnail"],
        "transcript_language": selected_language,
    }

    MOCK_LECTURES.append(new_lecture)
    TRANSCRIPTS_STORE[new_lec_id] = formatted_entries

    try:
        chunks = chunk_transcript(
            transcript_items=formatted_entries,
            lecture_id=new_lec_id,
            course_id=meta["title"],
            chunk_size=5,
            overlap=2,
        )
        index_lecture_chunks(
            lecture_id=new_lec_id, course_id=meta["title"], chunks=chunks
        )
        print(f"[RAG] Indexed {len(chunks)} chunks for lecture {new_lec_id}")
    except Exception as e:
        print(f"[RAG] Failed to index lecture {new_lec_id}: {e}")

    ai_materials = generate_ai_study_materials(
        lecture=new_lecture,
        transcript_chunks=formatted_entries,
        source_language=selected_language,
    )

    MOCK_SUMMARIES[new_lec_id] = ai_materials

    return {
        "status": "success",
        "lecture": new_lecture,
        "language": selected_language,
        "rag": {
            "indexed": True,
            "message": "Transcript chunked and indexed into ChromaDB.",
        },
        "ai_study_materials": {
            "summary_available": bool(
                MOCK_SUMMARIES.get(new_lec_id, {}).get("_summary_available", False)
            ),
            "revision_notes_available": bool(
                MOCK_SUMMARIES.get(new_lec_id, {}).get(
                    "_revision_notes_available", False
                )
            ),
            "message": "AI study material generation completed.",
        },
    }


